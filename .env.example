# --- サーバー側だけで使う秘密の値（リポジトリにコミットしない） ---
# AIはどちらか一方。GEMINI_API_KEY があれば Gemini、なければ Claude を使う
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SCREEN_KEY=

# --- 設定 ---
SUPABASE_URL=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
DAILY_LIMIT=1000
# 1 にするとAIを呼ばず固定の物語を返す（開発・リハーサル用）
MOCK_AI=0
